# Copy to .env and fill in. Real environment variables always override these values.
# AP rules
TOLERANCE_PCT=0.02
TOLERANCE_ABS=25.00
FUZZY_TOL_MULT=3.0
# Gemini (only model calls in the codebase — pipeline is deterministic without a key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AGENT_MAX_REPAIRS=2
