# Copy to .env and fill in. Real environment variables always override these values.
# AP rules
TOLERANCE_PCT=0.02
TOLERANCE_ABS=25.00
FUZZY_TOL_MULT=3.0
# Models: pick a provider in the sidebar, optionally override the model ID.
# Server keys (used unless a visitor pastes their own session key).
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
AGENT_MAX_REPAIRS=2
